{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "types": ["node"], "isolatedModules": true, "allowImportingTsExtensions": true
  },
  "include": ["server", "shared", "web", "test", "vite.config.ts", "vitest.config.ts"]
}
