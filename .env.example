# Copy to .env (git-ignored). Both credentials must be READ-ONLY.
# Linear: Settings > Account > Security & access > Personal API keys, permission "Read".
LINEAR_API_KEY=
# GitHub: fine-grained PAT limited to the configured repos, read-only:
#   Metadata, Pull requests, Contents, Actions  (all "Read-only"; Commit statuses is optional)
#   CI evidence is read from GitHub Actions workflow runs; check-run details are shown as Unavailable.
GITHUB_TOKEN=
# Optional
# DEVFLOW_PORT=4317
# DEVFLOW_CONFIG=./devflow.config.json
# DEVFLOW_DEMO=1   # serve clearly-labelled synthetic data, no network calls
