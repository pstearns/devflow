# Copy to .env (git-ignored, chmod 600). Never commit real values.

# Linear READ key: Settings > Account > Security & access > Personal API keys, permission "Read".
LINEAR_API_KEY=

# Linear WRITE key (optional). Enables the action menu: labels, status, milestone, approve/revoke readiness.
# Must be a DIFFERENT personal API key from LINEAR_API_KEY, with "Write" permission and access limited to the
# configured team(s). Without it DevFlow stays fully read-only. GitHub is never written.
LINEAR_WRITE_API_KEY=

# GitHub: fine-grained PAT limited to the configured repos, read-only:
#   Metadata, Pull requests, Contents, Actions  (all "Read-only"; Commit statuses is optional)
# CI evidence is read from GitHub Actions workflow runs; check-run details are shown as Unavailable.
GITHUB_TOKEN=

# Optional
# DEVFLOW_PORT=4317
# DEVFLOW_CONFIG=./devflow.config.json
# DEVFLOW_DEMO=1   # serve clearly-labelled synthetic data (including a fake Linear that accepts the actions), no network calls
